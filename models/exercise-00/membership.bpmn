<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_membership" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.20.0">
  <bpmn:process id="innerCircleMembership" name="Miravelo Inner Circle Membership" isExecutable="false">
    <bpmn:startEvent id="startEvent_submitRegistration" name="Submit registration form">
      <bpmn:outgoing>Flow_start_claim</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="serviceTask_claimMembership" name="Claim membership">
      <bpmn:incoming>Flow_start_claim</bpmn:incoming>
      <bpmn:outgoing>Flow_claim_gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gateway_hasEmptySpots" name="Free seat available?" default="Flow_gw_confirm">
      <bpmn:incoming>Flow_claim_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_confirm</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="serviceTask_sendConfirmationMail" name="Send confirmation mail">
      <bpmn:incoming>Flow_gw_confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_confirm_user</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="userTask_confirmMembership" name="Confirm membership">
      <bpmn:incoming>Flow_confirm_user</bpmn:incoming>
      <bpmn:outgoing>Flow_user_fork</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="gateway_notifyFork">
      <bpmn:incoming>Flow_user_fork</bpmn:incoming>
      <bpmn:outgoing>Flow_fork_welcome</bpmn:outgoing>
      <bpmn:outgoing>Flow_fork_notify</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="serviceTask_sendWelcomeMail" name="Send Welcome Mail">
      <bpmn:incoming>Flow_fork_welcome</bpmn:incoming>
      <bpmn:outgoing>Flow_welcome_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="serviceTask_notifyCommunity" name="Notify community">
      <bpmn:incoming>Flow_fork_notify</bpmn:incoming>
      <bpmn:outgoing>Flow_notify_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="gateway_notifyJoin">
      <bpmn:incoming>Flow_welcome_join</bpmn:incoming>
      <bpmn:incoming>Flow_notify_join</bpmn:incoming>
      <bpmn:outgoing>Flow_join_end</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="endEvent_membershipActivated" name="Membership activated">
      <bpmn:incoming>Flow_join_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="serviceTask_sendRejectionMail" name="Send rejection mail">
      <bpmn:incoming>Flow_gw_reject</bpmn:incoming>
      <bpmn:outgoing>Flow_reject_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endEvent_membershipRejected" name="Membership rejected">
      <bpmn:incoming>Flow_reject_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_claim" sourceRef="startEvent_submitRegistration" targetRef="serviceTask_claimMembership" />
    <bpmn:sequenceFlow id="Flow_claim_gw" sourceRef="serviceTask_claimMembership" targetRef="gateway_hasEmptySpots" />
    <bpmn:sequenceFlow id="Flow_gw_confirm" name="Yes" sourceRef="gateway_hasEmptySpots" targetRef="serviceTask_sendConfirmationMail" />
    <bpmn:sequenceFlow id="Flow_gw_reject" name="No" sourceRef="gateway_hasEmptySpots" targetRef="serviceTask_sendRejectionMail" />
    <bpmn:sequenceFlow id="Flow_confirm_user" sourceRef="serviceTask_sendConfirmationMail" targetRef="userTask_confirmMembership" />
    <bpmn:sequenceFlow id="Flow_user_fork" sourceRef="userTask_confirmMembership" targetRef="gateway_notifyFork" />
    <bpmn:sequenceFlow id="Flow_fork_welcome" sourceRef="gateway_notifyFork" targetRef="serviceTask_sendWelcomeMail" />
    <bpmn:sequenceFlow id="Flow_fork_notify" sourceRef="gateway_notifyFork" targetRef="serviceTask_notifyCommunity" />
    <bpmn:sequenceFlow id="Flow_welcome_join" sourceRef="serviceTask_sendWelcomeMail" targetRef="gateway_notifyJoin" />
    <bpmn:sequenceFlow id="Flow_notify_join" sourceRef="serviceTask_notifyCommunity" targetRef="gateway_notifyJoin" />
    <bpmn:sequenceFlow id="Flow_join_end" sourceRef="gateway_notifyJoin" targetRef="endEvent_membershipActivated" />
    <bpmn:sequenceFlow id="Flow_reject_end" sourceRef="serviceTask_sendRejectionMail" targetRef="endEvent_membershipRejected" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="innerCircleMembership">
      <bpmndi:BPMNShape id="startEvent_submitRegistration_di" bpmnElement="startEvent_submitRegistration">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="130" y="145" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="serviceTask_claimMembership_di" bpmnElement="serviceTask_claimMembership">
        <dc:Bounds x="250" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_hasEmptySpots_di" bpmnElement="gateway_hasEmptySpots" isMarkerVisible="true">
        <dc:Bounds x="410" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="390" y="62" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="serviceTask_sendConfirmationMail_di" bpmnElement="serviceTask_sendConfirmationMail">
        <dc:Bounds x="520" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="userTask_confirmMembership_di" bpmnElement="userTask_confirmMembership">
        <dc:Bounds x="680" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_notifyFork_di" bpmnElement="gateway_notifyFork">
        <dc:Bounds x="840" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="serviceTask_sendWelcomeMail_di" bpmnElement="serviceTask_sendWelcomeMail">
        <dc:Bounds x="950" y="20" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="serviceTask_notifyCommunity_di" bpmnElement="serviceTask_notifyCommunity">
        <dc:Bounds x="950" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_notifyJoin_di" bpmnElement="gateway_notifyJoin">
        <dc:Bounds x="1110" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_membershipActivated_di" bpmnElement="endEvent_membershipActivated">
        <dc:Bounds x="1222" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1200" y="145" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="serviceTask_sendRejectionMail_di" bpmnElement="serviceTask_sendRejectionMail">
        <dc:Bounds x="385" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_membershipRejected_di" bpmnElement="endEvent_membershipRejected">
        <dc:Bounds x="547" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="525" y="305" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_claim_di" bpmnElement="Flow_start_claim">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="250" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_claim_gw_di" bpmnElement="Flow_claim_gw">
        <di:waypoint x="350" y="120" />
        <di:waypoint x="410" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_gw_confirm_di" bpmnElement="Flow_gw_confirm">
        <di:waypoint x="460" y="120" />
        <di:waypoint x="520" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="479" y="102" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_gw_reject_di" bpmnElement="Flow_gw_reject">
        <di:waypoint x="435" y="145" />
        <di:waypoint x="435" y="240" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="443" y="180" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_confirm_user_di" bpmnElement="Flow_confirm_user">
        <di:waypoint x="620" y="120" />
        <di:waypoint x="680" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_user_fork_di" bpmnElement="Flow_user_fork">
        <di:waypoint x="780" y="120" />
        <di:waypoint x="840" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_fork_welcome_di" bpmnElement="Flow_fork_welcome">
        <di:waypoint x="865" y="95" />
        <di:waypoint x="865" y="60" />
        <di:waypoint x="950" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_fork_notify_di" bpmnElement="Flow_fork_notify">
        <di:waypoint x="865" y="145" />
        <di:waypoint x="865" y="180" />
        <di:waypoint x="950" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_welcome_join_di" bpmnElement="Flow_welcome_join">
        <di:waypoint x="1050" y="60" />
        <di:waypoint x="1135" y="60" />
        <di:waypoint x="1135" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_notify_join_di" bpmnElement="Flow_notify_join">
        <di:waypoint x="1050" y="180" />
        <di:waypoint x="1135" y="180" />
        <di:waypoint x="1135" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_join_end_di" bpmnElement="Flow_join_end">
        <di:waypoint x="1160" y="120" />
        <di:waypoint x="1222" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_reject_end_di" bpmnElement="Flow_reject_end">
        <di:waypoint x="485" y="280" />
        <di:waypoint x="547" y="280" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
